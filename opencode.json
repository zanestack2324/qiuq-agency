{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "hostinger-hosting": {
      "type": "local",
      "command": ["npx.cmd", "--package=hostinger-api-mcp@latest", "hostinger-hosting-mcp"],
      "enabled": true
    },
    "hostinger-domains": {
      "type": "local",
      "command": ["npx.cmd", "--package=hostinger-api-mcp@latest", "hostinger-domains-mcp"],
      "enabled": true
    },
    "hostinger-dns": {
      "type": "local",
      "command": ["npx.cmd", "--package=hostinger-api-mcp@latest", "hostinger-dns-mcp"],
      "enabled": true
    },
    "hostinger-billing": {
      "type": "local",
      "command": ["npx.cmd", "--package=hostinger-api-mcp@latest", "hostinger-billing-mcp"],
      "enabled": true
    },
    "hostinger-reach": {
      "type": "local",
      "command": ["npx.cmd", "--package=hostinger-api-mcp@latest", "hostinger-reach-mcp"],
      "enabled": true
    }
  }
}
